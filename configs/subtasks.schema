{
    "type" : "object",
    "properties" : {
        "global_validators": {
            "type": "array",
            "items": {
                "type": "string",
                "minLength": 0
            },
            "minItems": 0,
            "default": []
        },
        "subtask_sensitive_validators": {
            "type": "array",
            "items": {
                "type": "string",
                "minLength": 0
            },
            "minItems": 0,
            "default": []
        },
        "subtasks": {
            "type": "object",
            "patternProperties": {
                ".*": {
                    "type": "object",
                    "properties" : {
                        "index": {
                            "type": "integer",
                            "minimum": 0
                        },
                        "score": {
                            "type": "number"
                        },
                        "text": {
                            "type": "string",
                            "default": ""
                        },
                        "validators": {
                            "type": "array",
                            "items": {
                                "type": "string",
                                "minLength": 0
                            },
                            "minItems": 0,
                            "default": []
                        }
                    },
                    "required": [
                        "index",
                        "score"
                    ]
                }
            }
        }
    },
    "required": [
        "subtasks"
    ]
}
